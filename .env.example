# Required: your OpenJEV key (https://openjev.tech/docs)
OPENJEV_API_KEY=oj_live_your_key_here

# Optional, shown with defaults
OPENJEV_BASE_URL=https://api.openjev.sh/v1
OPENJEV_MODEL=openjev
OPENJEV_TIMEOUT_S=25
# Global pacing for upstream calls across all players (provider limit is 10/s)
OPENJEV_MAX_RPS=8

# Per-IP limits, requests per minute
RATE_LIMIT_NEW_GAME=15
RATE_LIMIT_NEXT_GUESS=30
RATE_LIMIT_SUBMIT_GUESS=60
RATE_LIMIT_VERSUS_NEW=15
RATE_LIMIT_VERSUS_GUESS=60
RATE_LIMIT_VERSUS_JEV=30
# Set to 1 only behind a proxy you control that sets X-Forwarded-For
TRUST_PROXY_HEADERS=0

GAME_TTL_S=3600
MAX_GAMES=5000
